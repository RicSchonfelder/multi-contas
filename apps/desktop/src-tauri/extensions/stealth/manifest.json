{
  "manifest_version": 3,
  "name": "Multi Contas Stealth",
  "version": "1.0",
  "description": "Spoof browser fingerprint for profile isolation",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "run_at": "document_start",
    "js": ["stealth.js"],
    "all_frames": true,
    "match_about_blank": true
  }],
  "web_accessible_resources": [{
    "resources": ["inject.js"],
    "matches": ["<all_urls>"]
  }]
}
